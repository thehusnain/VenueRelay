{
  "name": "venuerelay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:api": "node --import tsx --watch backend/src/index.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build": "tsc --noEmit && vite build --config frontend/vite.config.ts",
    "start": "node --env-file-if-exists=.env --import tsx backend/src/index.ts",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "typecheck": "tsc --noEmit",
    "api:docs": "node scripts/generate-openapi.mjs",
    "format:check": "prettier --check backend/src frontend/src shared scripts tests/*.ts tests/*.mjs frontend/vite.config.ts",
    "test:unit": "node --import tsx --test --test-isolation=none tests/domain.test.ts tests/accounts.test.ts tests/client-recovery.test.ts tests/offline.test.ts",
    "email:preview": "node --env-file-if-exists=.env scripts/email-preview.mjs",
    "test:design": "node tests/browser.mjs design",
    "push:keys": "node scripts/push-keys.mjs",
    "test:pwa": "node tests/browser.mjs pwa",
    "test:install": "node tests/browser.mjs install",
    "test:layout": "node tests/browser.mjs layout",
    "test:usability": "node tests/browser.mjs usability",
    "test:mongo": "node --import tsx --test --test-isolation=none tests/mongo.integration.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-mongo.ts",
    "check:deployment": "node scripts/check-deployment.mjs",
    "test:accounts": "node tests/browser.mjs account",
    "test:attendees": "node tests/browser.mjs attendee",
    "test:mobile": "node tests/browser.mjs mobile",
    "test:flow": "node tests/browser.mjs flow",
    "test:tutorial": "node tests/browser.mjs tutorial",
    "test:team": "node tests/browser.mjs team",
    "test:events": "node tests/browser.mjs events"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "idb": "^8.0.4",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.31.0",
    "mongodb": "^7.9.0",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "swagger-ui-dist": "^5.34.1",
    "tsx": "^4.21.0",
    "validator": "^13.15.35",
    "web-push": "^4.0.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/validator": "^13.15.10",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.0.2",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "^6.2.8",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
